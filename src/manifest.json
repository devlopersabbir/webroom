{
  "name": "WebRoom",
  "description": "Decentralized real-time presence layer for every webpage. See active peers on the same URL.",
  "homepage_url": "https://github.com/devlopersabbir/webroom",
  "{{chrome}}.manifest_version": 3,
  "{{chrome}}.minimum_chrome_version": "116.0",
  "{{firefox}}.manifest_version": 3,
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  },
  "background": {
    "{{chrome}}.service_worker": "src/background/index.ts",
    "{{firefox}}.scripts": ["src/background/index.ts"]
  },
  "host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "webroom-beta@devlopersabbir.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
