{
  "name": "webroom",
  "displayName": "WebRoom",
  "description": "Decentralized real-time presence layer for every webpage. See how many people are browsing the same page as you in real time...",
  "version": "1.16.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/devlopersabbir/webroom",
  "keywords": [
    "webroom",
    "presence",
    "peer-to-peer",
    "decentralized",
    "real-time",
    "browser-extension",
    "firefox-addon",
    "chrome-extension"
  ],
  "author": {
    "email": "devlopersabbir@gmail.com",
    "name": "Sabbir Hossain Shuvo",
    "url": "https://github.com/devlopersabbir"
  },
  "release": {
    "tagFormat": "v${version}",
    "branches": [
      "main",
      "master",
      "next",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": [
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "bun ./zip.ts TARGET=all"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "v*_chrome.zip",
              "label": "WebRoom Chrome Extension (v${nextRelease.version})"
            },
            {
              "path": "v*_firefox.zip",
              "label": "WebRoom Firefox Add-on (v${nextRelease.version})"
            }
          ]
        }
      ]
    ]
  },
  "bugs": {
    "email": "devlopersabbir@gmail.com",
    "url": "https://github.com/devlopersabbir/webroom/issues"
  },
  "repository": {
    "directory": "webroom",
    "type": "GIT",
    "url": "https://github.com/devlopersabbir/webroom"
  },
  "readme": "./README.md",
  "scripts": {
    "dev": "rm -rf dist && vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "bun run lint:firefox",
    "lint:firefox": "bun run build:firefox && bunx web-ext lint --source-dir=dist",
    "deploy:firefox": "bun ./scripts/deploy-firefox.ts",
    "zip": "bun ./zip.ts",
    "zip:all": "bun ./zip.ts TARGET=all",
    "zip:chrome": "bun ./zip.ts TARGET=chrome",
    "zip:firefox": "bun ./zip.ts TARGET=firefox",
    "build:chrome": "tsc && cross-env TARGET=chrome vite build",
    "build:firefox": "tsc && cross-env TARGET=firefox vite build"
  },
  "dependencies": {
    "@trystero-p2p/mqtt": "^0.25.3",
    "@trystero-p2p/torrent": "^0.25.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "trystero": "^0.25.3",
    "zip-a-folder": "^6.1.4"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@types/webextension-polyfill": "^0.10.0",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.1.0",
    "semantic-release": "^25.0.9",
    "typescript": "~5.6.3",
    "vite": "^5.0.0",
    "vite-plugin-web-extension": "^4.0.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0",
    "webextension-polyfill": "^0.10.0"
  }
}
