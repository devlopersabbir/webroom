{
  "name": "webroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": {
    "email": "devlopersabbir@gmail.com",
    "name": "Sabbir Hossain Shuvo",
    "url": "https://github.com/devlopersabbir"
  },
  "release": {
    "tagFormat": "v${version}",
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "master",
      "next",
      "next-major",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "repositoryUrl": "https://github.com/devlopersabbir/webroom"
  },
  "bugs": {
    "email": "devloeprsabbir@gmail.com",
    "url": "https://github.com/devlopersabbir"
  },
  "repository": {
    "directory": "webroom",
    "type": "GIT",
    "url": "https://github.com/devlopersabbir/webroom"
  },
  "readme": "./README.md",
  "scripts": {
    "dev": "rm -rf dist && vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "zip:chrome": "bun run build:chrome && bun ./zip.ts TARGET=chrome",
    "zip:firefox": "bun run build:firefox && bun ./zip.ts TARGET=firefox",
    "build:chrome": "cross-env TARGET=chrome tsc && vite build",
    "build:firefox": "cross-env TARGET=firefox tsc && vite build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zip-a-folder": "^6.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@types/webextension-polyfill": "^0.10.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "~5.6.3",
    "vite": "^5.0.0",
    "vite-plugin-web-extension": "^4.0.0",
    "vitest": "^4.1.11",
    "webextension-polyfill": "^0.10.0"
  }
}
